# Server
BIND_ADDR=0.0.0.0:3000
LOG_LEVEL=info

# Public URL of this CAS server (returned as casUrl in auth responses)
CAS_BASE_URL=http://localhost:3000

# Hub API base URL (used in LFS batch responses, commit URLs, etc.)
HUB_BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://xet:xet@localhost:5432/xetdb

# S3 / MinIO  (omit S3_ENDPOINT to use real AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=xet-storage
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# JWT (use at least 64 random chars in production)
JWT_SECRET=change-me-in-production-at-least-64-random-chars-xxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRY_SECS=3600

# Hub token secret (for hashing ox_* API tokens)
HUB_TOKEN_SECRET=change-me-in-production

# Templates directory (for web UI)
TEMPLATE_DIR=templates
